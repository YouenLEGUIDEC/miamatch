    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:db": "node --experimental-strip-types tests/database.mjs",
    "seed:generate": "node scripts/seed.mjs",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "dev": "expo start --dev-client"
